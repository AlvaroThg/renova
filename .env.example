# ─────────────────────────────────────────────
# RENOVA — variables de entorno
# Copiar este archivo como .env en la raíz y en apps/api/
#   cp .env.example .env && cp .env.example apps/api/.env
# ─────────────────────────────────────────────

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL="postgresql://renova:renova@localhost:5432/renova?schema=public"

# Autenticación
JWT_SECRET="cambiar-este-secreto-en-produccion-renova-2026"
JWT_EXPIRES_IN="12h"

# Usuario administrador creado por el seed
ADMIN_EMAIL="admin@renova.bo"
ADMIN_PASSWORD="renova2026"
ADMIN_NOMBRE="Operador RENOVA"

# Puertos
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Simulador de sensores (mientras no haya hardware real)
SIMULADOR_ACTIVO=true
SIMULADOR_INTERVALO_MS=3000
